@model List<TiendaVentas.Web.Models.ContactoImagen>

@{
    ViewData["Title"] = "Administrar Contacto";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>
            <h1 class="fw-bold mb-1">
                Panel de Contacto
            </h1>

            <p class="text-muted mb-0">
                Administra las imágenes de la página de contacto.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">

            <a asp-controller="AdminProductos"
               asp-action="Index"
               class="btn btn-outline-secondary rounded-pill">

                Volver al panel

            </a>

            <a asp-controller="AdminContacto"
               asp-action="Create"
               class="btn btn-dark rounded-pill">

                Nueva imagen

            </a>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 text-center">
            @TempData["Success"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card border-0 shadow rounded-4">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Imagen
                                </th>

                                <th>
                                    Título
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th>
                                    Fecha
                                </th>

                                <th class="text-end pe-4">
                                    Acciones
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="ps-4">

                                        <img src="@item.Imagen_Url"
                                             alt="@item.Titulo"
                                             style="
                                        width:110px;
                                        height:70px;
                                        object-fit:cover;
                                        border-radius:12px;
                                        border:1px solid #eee;" />

                                    </td>

                                    <td>

                                        <div class="fw-semibold">
                                            @item.Titulo
                                        </div>

                                        <small class="text-muted">
                                            ID: @item.Id_Imagen
                                        </small>

                                    </td>

                                    <td>

                                        @if (item.Estado == "A")
                                        {
                                            <span class="badge bg-success">
                                                Activa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactiva
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @item.Fecha_Creacion.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td class="text-end pe-4">

                                        @if (item.Estado == "A")
                                        {
                                            <form asp-action="Desactivar"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id_Imagen" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger rounded-pill"
                                                        onclick="return confirm('¿Deseas desactivar esta imagen?');">

                                                    Desactivar

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Activar"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id_Imagen" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success rounded-pill">

                                                    Activar

                                                </button>

                                            </form>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="alert alert-warning rounded-4 text-center">

            No hay imágenes registradas para contacto.

        </div>
    }

</div>